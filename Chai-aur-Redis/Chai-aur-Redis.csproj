<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>Chai_aur_Redis</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.15" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.4" />
		<PackageReference Include="Scalar.AspNetCore" Version="3.1.1" />
		<PackageReference Include="StackExchange.Redis" Version="3.4.35" />
	</ItemGroup>

</Project>

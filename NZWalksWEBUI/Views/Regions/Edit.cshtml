@model NZWalksWEBUI.Models.DTO.RegionDto

<h1 class="mt-3">Edit Region</h1>

<div class="row">
    <div class="col-md-6">
        @if (Model != null)
        {
            <form method="post" asp-action="Edit">
                <div class="mb-3">
                    <label class="form-label" asp-for="Id">Id</label>
                    <input type="text" class="form-control" asp-for="Id" readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label" asp-for="Code">Code</label>
                    <input type="text" class="form-control" asp-for="Code" readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label" asp-for="Name">Name</label>
                    <input type="text" class="form-control" asp-for="Name" required />
                </div>

                <div class="mb-3">
                    <label class="form-label" asp-for="RegionImageUrl">Region Image Url</label>
                    <input type="text" class="form-control" asp-for="RegionImageUrl" />
                </div>

                <div class="mb-3 d-flex justify-content-between">
                    <div>
                        <button type="submit" class="btn btn-primary">Save</button>
                        <a asp-controller="Regions" asp-action="Index" class="btn btn-secondary">Cancel</a>
                    </div>
                    <button type="submit" class="btn btn-danger" asp-action="Delete" asp-controller="Regions" formmethod="post">Delete</button>
                </div>
            </form>
        }
        else
        {
            <p>Region not found!</p>
        }
    </div>
</div>

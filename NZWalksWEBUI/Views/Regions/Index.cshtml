@model IEnumerable<NZWalksWEBUI.Models.DTO.RegionDto>

<h1 class="mt-3">Regions</h1>

<div class="d-flex justify-content-end mb-3">
    <a class="btn btn-primary" asp-controller="Regions" asp-action="Add">Add Region</a>
</div>

@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger" role="alert">
        @ViewBag.ErrorMessage
    </div>
}

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Code</th>
            <th>Name</th>
            <th>Image Url</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var region in Model)
            {
                <tr>
                    <td>@region.Id</td>
                    <td>@region.Code</td>
                    <td>@region.Name</td>
                    <td>@region.RegionImageUrl</td>
                    <td>
                        <a asp-controller="Regions" asp-action="Edit" asp-route-id="@region.Id" class="btn btn-light">Edit</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="5" class="text-center">No regions found.</td>
            </tr>
        }
    </tbody>
</table>

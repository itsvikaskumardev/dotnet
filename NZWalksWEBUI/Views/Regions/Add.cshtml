@model NZWalksWEBUI.Models.DTO.AddRegionViewModel

<h1 class="mt-3">Add Region</h1>

<div class="row">
    <div class="col-md-6">
        <form method="post" asp-action="Add">
            <div class="mb-3">
                <label class="form-label" asp-for="Code">Code</label>
                <input type="text" class="form-control" asp-for="Code" required />
            </div>

            <div class="mb-3">
                <label class="form-label" asp-for="Name">Name</label>
                <input type="text" class="form-control" asp-for="Name" required />
            </div>

            <div class="mb-3">
                <label class="form-label" asp-for="RegionImageUrl">Region Image Url</label>
                <input type="text" class="form-control" asp-for="RegionImageUrl" />
            </div>

            <div class="mb-3">
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-controller="Regions" asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

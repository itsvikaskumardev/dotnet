@model NZWalksWEBUI.Models.DTO.UpdateWalkViewModel

<h1 class="mt-3">Edit Walk</h1>

<div class="row">
    <div class="col-md-6">
        @if (Model != null)
        {
            <form method="post" asp-action="Edit">
                <div class="mb-3">
                    <label class="form-label" asp-for="Id">Id</label>
                    <input type="text" class="form-control" asp-for="Id" readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label" asp-for="Name">Name</label>
                    <input type="text" class="form-control" asp-for="Name" required />
                </div>

                <div class="mb-3">
                    <label class="form-label" asp-for="Description">Description</label>
                    <textarea class="form-control" asp-for="Description" required></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label" asp-for="LengthInKm">Length In Km</label>
                    <input type="number" step="0.01" class="form-control" asp-for="LengthInKm" required />
                </div>

                <div class="mb-3">
                    <label class="form-label" asp-for="WalkImageUrl">Walk Image Url</label>
                    <input type="text" class="form-control" asp-for="WalkImageUrl" />
                </div>

                <div class="mb-3">
                    <label class="form-label" asp-for="RegionId">Region</label>
                    <select class="form-select" asp-for="RegionId" asp-items="@Model.Regions">
                        <option value="">Select Region</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label" asp-for="DifficultyId">Difficulty</label>
                    <select class="form-select" asp-for="DifficultyId" asp-items="@Model.Difficulties">
                        <option value="">Select Difficulty</option>
                    </select>
                </div>

                <div class="mb-3 d-flex justify-content-between">
                    <div>
                        <button type="submit" class="btn btn-primary">Save</button>
                        <a asp-controller="Walks" asp-action="Index" class="btn btn-secondary">Cancel</a>
                    </div>
                    <button type="submit" class="btn btn-danger" asp-action="Delete" asp-controller="Walks" formmethod="post">Delete</button>
                </div>
            </form>
        }
        else
        {
            <p>Walk not found!</p>
        }
    </div>
</div>
